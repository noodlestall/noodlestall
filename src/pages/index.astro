---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveControls from '../components/ArchiveControls.astro';
import RecipeEntry from '../components/RecipeEntry.astro';
import { getNumberedRecipes, toIndexEntry } from '../lib/recipes';
import { SITE, safeJson } from '../lib/site';

const recipes = await getNumberedRecipes();
const index = recipes.map(toIndexEntry);
const base = import.meta.env.BASE_URL;
const count = recipes.length;
---

<BaseLayout title={SITE.name} description={SITE.description} path={base} current="archive">
  <div class="archive-head">
    <h1>Recipe index</h1>
    <p class="eyebrow"><strong>{count}</strong> {count === 1 ? 'recipe' : 'recipes'} on file</p>
  </div>

  <ArchiveControls />

  <div class="results-bar">
    <p id="results-status" aria-live="polite" aria-atomic="true">Showing all {count} recipes</p>
  </div>

  <ol class="recipe-index" id="recipe-index" aria-label="Recipes">
    {recipes.map((recipe, i) => <RecipeEntry recipe={recipe} loading={i < 4 ? 'eager' : 'lazy'} />)}
  </ol>

  <p class="empty-state" id="empty-state" hidden>
    No recipes match. Try fewer filters or a different word.
  </p>

  <script type="application/json" id="recipe-index-data" set:html={safeJson(index)} />
  <script>
    import '../scripts/archive';
  </script>
</BaseLayout>
