---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  instructions: CollectionEntry<'recipes'>['data']['instructions'];
}
const { instructions } = Astro.props;
---

<section aria-labelledby="method-heading">
  <h2 class="section-title" id="method-heading">Method</h2>
  <ol class="steps" id="steps">
    {
      instructions.map((step, i) => {
        const n = String(i + 1).padStart(2, '0');
        return (
          <li class="step" data-step={i}>
            <div class="step__body">
              <h3 class="step__title">
                <span class="step__number" aria-hidden="true">{n}</span>
                <span>{step.title ?? `Step ${i + 1}`}</span>
              </h3>
              <p class="step__text">{step.text}</p>
              {step.image && (
                <figure class="step__image">
                  {step.image.format === 'svg' ? (
                    <Image src={step.image} alt={step.imageAlt ?? ''} loading="lazy" decoding="async" />
                  ) : (
                    <Image src={step.image} alt={step.imageAlt ?? ''} width={800} height={600} widths={[448, 800]} sizes="(min-width: 40em) 448px, 100vw" fit="cover" loading="lazy" decoding="async" format="webp" />
                  )}
                </figure>
              )}
            </div>
          </li>
        );
      })
    }
  </ol>
</section>
