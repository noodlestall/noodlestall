---
/* Paper (light) and Ink (dark). Defaults to the system preference; the choice is remembered in the browser. */
---

<button type="button" class="btn btn--small theme-toggle" id="theme-toggle" aria-live="polite">
  <span data-theme-label>Ink mode</span>
</button>

<script>
  import { THEME_KEY } from '../lib/storage';

  type Theme = 'paper' | 'ink';
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');
  const label = button?.querySelector('[data-theme-label]');
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  function current(): Theme {
    const forced = root.getAttribute('data-theme');
    if (forced === 'paper' || forced === 'ink') return forced;
    return media.matches ? 'ink' : 'paper';
  }

  function render() {
    if (!button || !label) return;
    const next: Theme = current() === 'ink' ? 'paper' : 'ink';
    label.textContent = next === 'ink' ? 'Ink mode' : 'Paper mode';
    button.setAttribute('aria-label', `Switch to ${next} mode`);
  }

  button?.addEventListener('click', () => {
    const next: Theme = current() === 'ink' ? 'paper' : 'ink';
    root.setAttribute('data-theme', next);
    try {
      window.localStorage.setItem(THEME_KEY, next);
    } catch {
      /* ignore */
    }
    render();
  });

  media.addEventListener('change', render);
  render();
</script>
