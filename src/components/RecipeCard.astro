---
const { title, category, image, slug, totalTime, difficulty } = Astro.props;
---
<article class="card">
  <a class="card-link" href={`/recipes/${slug}/`}>
    <div class="card-media">
      {image ? <img src={image} alt={title} loading="lazy" /> : <img src="/public/favicon.svg" alt="" />}
    </div>
    <div class="card-body">
      <h3>{title}</h3>
      <p class="muted">{category} · {totalTime} {difficulty ? `· ${difficulty}` : ''}</p>
    </div>
  </a>
</article>
