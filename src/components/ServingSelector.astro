---
const { recipe } = Astro.props;
---
<div class="servings">
  <label for="servings-input">Servings</label>
  <div class="servings-controls">
    <button id="dec" aria-label="Decrease servings">−</button>
    <input id="servings-input" type="number" min="0.5" step="0.5" value={recipe.servings} aria-label="Servings input" />
    <button id="inc" aria-label="Increase servings">+</button>
    <button id="reset" aria-label="Reset servings">Reset</button>
  </div>
</div>

<script>
  (function(){
    const key = `servings-${location.pathname}`;
    const input = document.getElementById('servings-input');
    const dec = document.getElementById('dec');
    const inc = document.getElementById('inc');
    const reset = document.getElementById('reset');
    const original = Number(input.value);
    const save = (v) => sessionStorage.setItem(key, String(v));
    const load = () => sessionStorage.getItem(key) || original;
    input.value = load();
    dec.addEventListener('click', ()=>{ input.value = Math.max(0.5, Number(input.value)-0.5); save(input.value); dispatchEvent(new Event('servingschange')); });
    inc.addEventListener('click', ()=>{ input.value = Number(input.value)+0.5; save(input.value); dispatchEvent(new Event('servingschange')); });
    reset.addEventListener('click', ()=>{ input.value = original; save(input.value); dispatchEvent(new Event('servingschange')); });
    input.addEventListener('change', ()=>{ if (Number(input.value) < 0.5) input.value = 0.5; save(input.value); dispatchEvent(new Event('servingschange')); });
  })();
</script>
