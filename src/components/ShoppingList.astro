---
import { buildShoppingListMessage, buildWhatsAppUrl } from '../lib/sharing';
import { buildShoppingGroups, itemKey, type ClientRecipe } from '../lib/shopping';

interface Props {
  recipe: ClientRecipe;
}
const { recipe } = Astro.props;
const groups = buildShoppingGroups(recipe, recipe.servings, new Set());
const initialMessage = buildShoppingListMessage({ recipeTitle: recipe.title, servings: recipe.servings, groups });
const showGroupTitles = groups.length > 1;
---

<details class="shopping" id="shopping">
  <summary>Shopping list</summary>
  <p class="shopping__intro">Uses the servings selected above. Tick what you already have; only the rest is copied or shared.</p>
  {
    groups.map((group, g) => (
      <div class="shopping__group">
        {showGroupTitles && <h3>{group.title}</h3>}
        <ul class="shopping__list">
          {group.items.map((item, i) => (
            <li>
              <label class="shopping__item">
                <input type="checkbox" data-shopping-item={itemKey(g, i)} />
                <span class="shopping__label" data-shopping-label={itemKey(g, i)}>{item.label}</span>
              </label>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
  <div class="shopping__actions">
    <button type="button" class="btn btn--small" id="shopping-copy">Copy list</button>
    <a class="btn btn--small" id="shopping-whatsapp" href={buildWhatsAppUrl(initialMessage)} target="_blank" rel="noopener noreferrer">Share via WhatsApp</a>
  </div>
  <p class="shopping__status" id="shopping-status" aria-live="polite"></p>
</details>
