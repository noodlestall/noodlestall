---
/* Cover image in a square crop for the index, or a wide crop on the recipe sheet. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CategoryPlaceholder from './CategoryPlaceholder.astro';
import type { Category } from '../lib/recipe-schema';

interface Props {
  image?: ImageMetadata;
  alt: string;
  title: string;
  category: Category;
  variant: 'thumb' | 'hero';
  loading?: 'lazy' | 'eager';
}
const { image, alt, title, category, variant, loading = 'lazy' } = Astro.props;
const isSvg = image?.format === 'svg';
---

{
  !image ? (
    <CategoryPlaceholder category={category} title={title} />
  ) : isSvg ? (
    <Image src={image} alt={alt} loading={loading} decoding="async" />
  ) : variant === 'thumb' ? (
    <Image
      src={image}
      alt={alt}
      width={320}
      height={320}
      widths={[160, 320, 480]}
      sizes="(min-width: 40em) 160px, 96px"
      fit="cover"
      loading={loading}
      decoding="async"
      format="webp"
    />
  ) : (
    <Image
      src={image}
      alt={alt}
      width={1200}
      height={800}
      widths={[640, 960, 1200, 1600]}
      sizes="(min-width: 76rem) 1200px, 100vw"
      fit="cover"
      loading={loading}
      decoding="async"
      format="webp"
    />
  )
}
