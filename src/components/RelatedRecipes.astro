---
import RecipeEntry from './RecipeEntry.astro';
import type { NumberedRecipe } from '../lib/recipes';

interface Props {
  recipes: NumberedRecipe[];
}
const { recipes } = Astro.props;
---

{
  recipes.length > 0 && (
    <section class="related" aria-labelledby="related-heading">
      <h2 class="section-title" id="related-heading">See also</h2>
      <ul class="related-list">
        {recipes.map((recipe) => (
          <RecipeEntry recipe={recipe} headingLevel="h3" />
        ))}
      </ul>
    </section>
  )
}
