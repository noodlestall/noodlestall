---
import CoverImage from './CoverImage.astro';
import { metaLine, type NumberedRecipe } from '../lib/recipes';
import { formatRecipeNumber, recipePath } from '../lib/site';

interface Props {
  recipe: NumberedRecipe;
  loading?: 'lazy' | 'eager';
}
const { recipe, loading = 'lazy' } = Astro.props;
const { entry, number } = recipe;
const { data } = entry;
const href = recipePath(import.meta.env.BASE_URL, entry.id);
---

<!-- The title link is stretched over the whole entry with a pseudo-element, so one link covers the card. -->
<li class="entry" data-id={entry.id}>
  <div class="entry__media">
    <CoverImage
      image={data.coverImage}
      alt=""
      title={data.title}
      category={data.category}
      variant="thumb"
      loading={loading}
    />
  </div>
  <div class="entry__body">
    <p class="entry__number">{formatRecipeNumber(number)}</p>
    <h2 class="entry__title">
      <a href={href}>{data.title}</a>
      {data.draft && <span class="entry__draft">Draft</span>}
    </h2>
    <p class="entry__meta">{metaLine(data)}</p>
    <p class="entry__desc">{data.description}</p>
  </div>
</li>
