---
/* Shown when a recipe has no photograph yet. Drafts are never passed off as finished entries. */
import { CATEGORY_LABELS, type Category } from '../lib/recipe-schema';

interface Props {
  category: Category;
  title: string;
}
const { category, title } = Astro.props;
const label = CATEGORY_LABELS[category].toUpperCase();
---

<svg class="placeholder" viewBox="0 0 400 400" role="img" aria-label={`No photograph yet for ${title}`}>
  <rect x="20" y="20" width="360" height="360" fill="none" stroke="currentColor" stroke-width="2" opacity="0.5" />
  <rect x="34" y="34" width="332" height="332" fill="none" stroke="currentColor" stroke-width="1" opacity="0.35" />
  <text x="200" y="190" text-anchor="middle" font-family="American Typewriter, Courier Prime, Courier New, monospace" font-size="26" letter-spacing="6" fill="currentColor">{label}</text>
  <line x1="120" y1="212" x2="280" y2="212" stroke="currentColor" stroke-width="1" opacity="0.6" />
  <text x="200" y="244" text-anchor="middle" font-family="American Typewriter, Courier Prime, Courier New, monospace" font-size="13" letter-spacing="3" fill="currentColor" opacity="0.7">PHOTOGRAPH PENDING</text>
</svg>
