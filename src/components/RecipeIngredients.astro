---
const { recipe } = Astro.props;
import { scaleQuantity, formatQuantity } from '../lib/scaling';
---
<section class="ingredients">
  <h2>Ingredients</h2>
  <div id="ingredients-list">
    {recipe.ingredients.map((ing) => (
      <div class="ingredient" data-quantity={ing.quantity} data-unit={ing.unit}>
        <strong>{ing.name}</strong>
        <div class="qty">{ing.quantity ? `${formatQuantity(ing.quantity)} ${ing.unit}` : (ing.note || '')}</div>
      </div>
    ))}
  </div>
</section>

<script>
  (function(){
    const list = document.getElementById('ingredients-list');
    const key = `servings-${location.pathname}`;
    const original = Number(document.querySelector('#ingredients-list .ingredient')?.dataset.quantity || 0);
    function apply() {
      const s = Number(sessionStorage.getItem(key) || 0) || undefined;
      document.querySelectorAll('#ingredients-list .ingredient').forEach(el => {
        const q = el.dataset.quantity ? Number(el.dataset.quantity) : undefined;
        const unit = el.dataset.unit;
        if (q !== undefined && s !== undefined) {
          const origServ = Number(1); // Not ideal: client doesn't know original servings; page-level JS could expose it.
          const scaled = (q * s) / (window.__originalServings || 1);
          el.querySelector('.qty').innerText = `${Number(scaled.toFixed(2))} ${unit}`;
        }
      });
    }
    window.addEventListener('servingschange', apply);
    apply();
  })();
</script>
