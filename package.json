{
  "name": "boathouse-noodles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Boathouse Noodles – a personal recipe archive built with Astro and hosted on GitHub Pages.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "tsx scripts/validate-recipes.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run validate && npm run check && npm run test && npm run build",
    "serve": "node scripts/serve-dist.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
